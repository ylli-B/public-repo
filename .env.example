# Local-first (Docker Compose defaults). Never commit real secrets.
AWS_REGION=us-east-1
AWS_PROFILE=nfl-edge

# Discovery Lab — NFL key often does NOT unlock MLB (401). Prefer sport-specific keys.
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_API_KEY_MLB=

# NFL Postgres (Compose service postgres → host 5433)
DATABASE_URL=postgresql://nfl_edge:nfl_edge_dev@localhost:5433/nfl_edge
# dbt profile target (NFL)
DBT_HOST=localhost
DBT_PORT=5433
DBT_USER=nfl_edge
DBT_PASSWORD=nfl_edge_dev
DBT_DBNAME=nfl_edge

# MLB Postgres (Compose service mlb-postgres → host 5434)
MLB_DATABASE_URL=postgresql://mlb_edge:mlb_edge_dev@localhost:5434/mlb_edge
MLB_EDGE_DB_HOST=localhost
MLB_EDGE_DB_PORT=5434
MLB_EDGE_DB_USER=mlb_edge
MLB_EDGE_DB_PASSWORD=mlb_edge_dev
MLB_EDGE_DB_NAME=mlb_edge

# Local bronze root (default; NFL + MLB share lake with sport= partition)
BRONZE_ROOT=data/bronze
# Cloud buckets — unused until cheap AWS mode
S3_RAW_BUCKET=
S3_CURATED_BUCKET=
S3_MODEL_BUCKET=
KAFKA_BOOTSTRAP_SERVERS=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_BASE_URL=http://localhost:8000

# --- MLB DFS gameday alerts (ml.mlb.dfs_daily) ---
# Twilio: console.twilio.com -> buy a number (~$1.15/mo), SMS ~$0.0079 each
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- notification channels (ml.mlb.notify) ---
# ntfy: free, no account. Subscribe by opening https://ntfy.sh/<topic> on your phone.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# telegram: free, most reliable, needs the Telegram app. Token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# override channel order, e.g. telegram,ntfy,twilio
NOTIFY_CHANNELS=

# --- Kalshi prediction market (ml.nfl.kalshi_card) ---
# API key from Kalshi dashboard → API Keys
KALSHI_KEY_ID=
# Path to RSA private key PEM file (generate with openssl genrsa)
KALSHI_PRIVATE_KEY_PATH=
